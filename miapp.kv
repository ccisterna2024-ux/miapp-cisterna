<MainScreen>:
    MDBoxLayout:
        orientation: "vertical"
        spacing: "20dp"
        padding: "20dp"
        pos_hint: {"center_x": 0.5, "center_y": 0.5}
        size_hint: 0.9, None
        height: self.minimum_height

        # 1. Interfaz: Campo de texto
        MDTextField:
            id: input_texto
            mode: "filled"
            hint_text: "Ingresa un texto aquí..."
            size_hint_x: 1

        # 1. Interfaz: Botón para guardar
        MDButton:
            style: "filled"
            pos_hint: {"center_x": 0.5}
            on_release: root.guardar_texto()

            MDButtonText:
                text: "Guardar"